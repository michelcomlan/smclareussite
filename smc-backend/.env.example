# Copier ce fichier en ".env" et remplir les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel dans Git.

# Port du serveur
PORT=4000

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
# Clé "service_role" (PAS la clé "anon") — donne un accès complet, contourne RLS.
# À garder strictement secrète, uniquement côté serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx...

# Authentification admin
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=12h

# FedaPay
FEDAPAY_SECRET_KEY=sk_test_xxxxx
FEDAPAY_ENV=sandbox
# Clé utilisée pour valider la signature des webhooks FedaPay
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxx

# URL du front-end (pour les redirections après paiement + CORS)
FRONTEND_URL=http://localhost:5173

# Envoi de SMS (codes OTP pour "retrouver mes achats")
# "console" = mode développement, le code s'affiche dans les logs serveur.
# "generic_http" = fournisseur réel à configurer (voir src/utils/smsSender.js).
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
